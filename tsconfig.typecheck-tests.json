{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "exclude": [
    "node_modules",
    "electron/node_modules",
    "electron/dist-electron",
    ".build",
    "open-sse",
    "dist",
    "coverage",
    "**/*.stories.tsx",
    ".source",
    ".tmp",
    ".claude",
    ".worktrees",
    "@omniroute",
    "_tasks",
    "_ideia",
    "_mono_repo",
    "_references",
    "tests/e2e/**"
  ]
}
